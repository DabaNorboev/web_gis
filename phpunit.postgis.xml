<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostGISWrite">
            <directory>tests/Integration</directory>
            <exclude>tests/Integration/PostgisConnectionTest.php</exclude>
            <exclude>tests/Integration/RoutingGeometryGuardTest.php</exclude>
            <exclude>tests/Integration/RoutingSnapTest.php</exclude>
            <exclude>tests/Integration/PlaceAnalysisTest.php</exclude>
        </testsuite>
        <testsuite name="PostGISReadOnly">
            <file>tests/Integration/PostgisConnectionTest.php</file>
            <file>tests/Integration/RoutingGeometryGuardTest.php</file>
            <file>tests/Integration/RoutingSnapTest.php</file>
            <file>tests/Integration/PlaceAnalysisTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="PLACE_ANALYSIS_PARKS_ENABLED" value="false" force="true"/>
        <env name="PLACE_ANALYSIS_PARKS_ENABLED" value="false" force="true"/>
        <!-- Local provider activation must not leak into isolated tests. -->
        <server name="PLACE_ANALYSIS_OFFICIAL_STOPS_ENABLED" value="false" force="true"/>
        <env name="PLACE_ANALYSIS_OFFICIAL_STOPS_ENABLED" value="false" force="true"/>
        <!-- Laravel also reads inherited $_SERVER values before $_ENV. Pin both. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="web_gis_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="web_gis_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
